  <ItemGroup>
    <ProjectReference Include="..\Temporalio\Temporalio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
