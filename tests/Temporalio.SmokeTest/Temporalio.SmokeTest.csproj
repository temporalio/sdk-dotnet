<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Release smoke tests restore from multiple remote sources (e.g. the NuGet
      integration gallery plus nuget.org). As an error, NU1507 fails restore
      before packages are extracted on Windows.
    -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <!--
  Intentionally not added, expected to be added by caller/CI
  <ItemGroup>
    <PackageReference Include="Temporalio" Version="some-version" />
  </ItemGroup>
  -->

</Project>